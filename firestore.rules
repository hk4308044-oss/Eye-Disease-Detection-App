rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isDoctor() {
      return isAuthenticated() && (getUserRole() == 'doctor');
    }

    function isAdmin() {
      return isAuthenticated() && (getUserRole() == 'admin');
    }

    // User profiles & patient screening records
    match /users/{uid} {
      allow read, write: if isOwner(uid) || isAdmin();
      allow read: if isDoctor();

      match /screenings/{screeningId} {
        allow read, write: if isOwner(uid) || isAdmin();
        allow read: if isDoctor();
      }
    }

    // Doctors collection
    match /doctors/{uid} {
      allow read: if isAuthenticated();
      allow write: if isOwner(uid) || isAdmin();
    }

    // Appointments
    match /appointments/{appointmentId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.patientId ||
        request.auth.uid == resource.data.doctorId ||
        isAdmin()
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.doctorId ||
        request.auth.uid == resource.data.patientId ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Notifications
    match /notifications/{uid}/items/{notifId} {
      allow read, write: if isOwner(uid) || isAdmin();
      allow create: if isAuthenticated();
    }

    // Audit logs (Admin only read/write)
    match /audit_logs/{logId} {
      allow read, write: if isAdmin();
    }

    // Content items (Read by all authenticated users, write by Admin only)
    match /content_items/{itemId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
